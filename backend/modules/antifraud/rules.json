{
  "version": 1,
  "description": "反诈话术规则库：每条规则是一类常见理财/保健品诈骗话术，命中时累加风险权重。patterns 为 Python 正则（对转写和画面文字逐段匹配，IGNORECASE）。可扩充。",
  "rules": [
    {
      "id": "guaranteed_high_return",
      "category": "保本高收益",
      "name": "保本/稳赚/零风险承诺",
      "patterns": [
        "保本保息", "保本理财", "稳赚不赔", "稳赚不?亏", "零风险", "无风险",
        "保证收益", "保底收益", "刚性兑付", "绝对盈利", "包赚", "稳收益",
        "保本?高收益", "高收益.?保本", "本金无忧", "安全无风险"
      ],
      "weight": 8,
      "description": "承诺保本且高收益，违反\"投资有风险\"的基本常识，是理财诈骗最典型的话术。"
    },
    {
      "id": "exaggerated_return",
      "category": "夸大收益",
      "name": "翻倍/暴涨/躺赚/日入过万",
      "patterns": [
        "翻倍", "翻几?番", "暴涨", "暴富", "日入[过万]?\\s*万", "月入过万", "月入\\s*[0-9]+\\s*万",
        "躺赚", "躺赢", "被动收入", "睡后收入", "收益?高达?\\s*[0-9]+\\s*[%％]",
        "年化?收益?\\s*[2-9][0-9]\\s*[%％]", "年化?\\s*[1-9][0-9]{2}\\s*[%％]",
        "十倍", "百倍", "一本万利"
      ],
      "weight": 6,
      "description": "夸大收益、宣传不切实际的高回报率，常见于理财和投资诈骗。"
    },
    {
      "id": "limited_urgency",
      "category": "限时名额",
      "name": "限时/限量/名额紧迫",
      "patterns": [
        "限时", "限量", "名额有限", "仅剩", "最后[几个]?名?额", "抢购", "先到先得",
        "马上截止", "即将?截止", "倒计时", "仅此一次", "错过?再?等?一年", "手慢无",
        "今日?特惠", "最后机会", "马上下架"
      ],
      "weight": 4,
      "description": "制造紧迫感迫使快速决策，是诈骗和营销话术的常见特征，单独命中风险较低，常与其他话术叠加。"
    },
    {
      "id": "insider_info",
      "category": "内部消息",
      "name": "内部消息/内幕/专属渠道",
      "patterns": [
        "内部消息", "内幕", "内部渠道", "内部名额", "专属渠道", "内部福利",
        "内部?推荐", "内部?代码", "内幕消息", "消息灵通", "提前?布局",
        "主力?动向", "庄家?洗盘", "跟庄", "跟主力"
      ],
      "weight": 7,
      "description": "声称掌握内部消息或内幕，诱导相信有\"信息差\"可获利，是荐股和理财诈骗的核心话术。"
    },
    {
      "id": "expert_endorsement",
      "category": "专家背书",
      "name": "专家/名师/导师推荐",
      "patterns": [
        "专家推荐", "名师?推荐", "导师推荐", "分析师推荐", "资深?推荐",
        "权威认证", "权威推荐", "专家?背书", "大师?指导", "老师?带单",
        "金牌?导师", "首席?分析师", "独家?解读"
      ],
      "weight": 5,
      "description": "用专家、名师头衔背书建立信任，常配合\"带单\"\"指导\"出现，需核查其资质真实性。"
    },
    {
      "id": "add_wechat_for_benefit",
      "category": "加微信领取",
      "name": "加微信/扫码领资料",
      "patterns": [
        "加微信", "加我微信", "加\\s*V\\s*[Xx]?", "添加微信", "扫码加微信",
        "微信号?[:：]?\\s*领", "领资料.?加", "咨询加微信", "加微信?领",
        "扫码领取", "扫码加群", "进群?领", "加好友?领", "私聊?领",
        "免费?领.?加", "加微信.?免费"
      ],
      "weight": 6,
      "description": "引导加微信、扫码进群领取资料/福利，是诈骗引流的关键环节，把受害者从公开平台转移到私域。"
    },
    {
      "id": "follow_and_trade",
      "category": "跟单带单",
      "name": "跟单/带单/指导操作",
      "patterns": [
        "跟单", "带单", "老师带单", "指导(?:操作|买入|卖出|买卖|建仓)",
        "(?:跟我操作|跟着我操作)", "同步操作", "复制操作", "(?:跟单买入|跟我买入)",
        "喊单", "喊单老师", "操盘指导"
      ],
      "weight": 7,
      "description": "声称可以带单、指导买卖操作，诱导跟风投入资金，是荐股和虚拟币诈骗的典型话术。"
    },
    {
      "id": "false_authority",
      "category": "资质误导",
      "name": "正规/官方/国家认证",
      "patterns": [
        "正规平台", "合法合规", "国家认证", "官方授权", "政府?背景",
        "国企?背景", "银行?合作", "监管?认可", "权威?机构?认证"
      ],
      "weight": 5,
      "description": "自称正规、官方、国家认证，需核查机构是否真实存在及是否具备相应资质。"
    },
    {
      "id": "health_therapy",
      "category": "保健品疗效",
      "name": "包治百病/根治/神奇疗效",
      "patterns": [
        "包治百病", "根治", "彻底?治愈", "神奇?疗效", "药到病除",
        "百病?不?生", "延年益寿", "长生不老", "提高?免疫力.?防?癌",
        "治愈率?\\s*[89][0-9]\\s*[%％]", "有效率?\\s*[89][0-9]\\s*[%％]",
        "祖传?秘方", "宫廷?秘方"
      ],
      "weight": 7,
      "description": "保健品宣传治疗疾病、保证疗效，违反\"保健品不能代替药物\"的规定，是保健品诈骗的典型话术。"
    },
    {
      "id": "target_elderly",
      "category": "针对老年",
      "name": "针对中老年/退休人群",
      "patterns": [
        "中老年?专享", "退休?人?专享", "养老?理财", "夕阳红",
        "给?爸妈?买", "孝敬?父母", "中老年?必备", "老年?特惠"
      ],
      "weight": 3,
      "description": "针对中老年、退休人群定向营销，该群体防骗能力较弱，是诈骗的高危目标筛选信号。"
    }
  ],
  "scoring": {
    "description": "风险评分：基础分=命中规则权重之和，加上引流信号加分，再映射到低/中/高。",
    "drainage_weights": {
      "wechat_id": 3,
      "phone": 2,
      "qrcode": 4,
      "suspicious_url": 2,
      "max_per_type": 3
    },
    "thresholds": {
      "high": 12,
      "medium": 6
    },
    "no_match_base": 0
  }
}
