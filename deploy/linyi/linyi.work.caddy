
# linyi.work: one path per project. 帧寻 (ZhenXun) runs in ~/projects/zhenxun.
linyi.work {
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    redir /ZhenXun /ZhenXun/ 308

    handle_path /ZhenXun/* {
        reverse_proxy zhenxun:8000
    }

    handle {
        respond "linyi.work" 200
    }
}

www.linyi.work {
    redir https://linyi.work{uri} permanent
}
